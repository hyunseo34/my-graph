import pandas as pd
import plotly.express as px
import streamlit as st

# 페이지 기본 설정
st.set_page_config(
    page_title="영화 데이터 그래프 도감 1 - 시간",
    page_icon="🎬",
    layout="wide",
)

st.title("🎬 영화 데이터 그래프 도감 1 - 시간")
st.markdown("---")

DATA_URL = (
    "https://raw.githubusercontent.com/greatsong/modudata/main/data/kobis_daily.csv"
)


# 데이터 캐싱 로드
@st.cache_data
def load_data():
    # 1년치(365일) 일별 박스오피스 10위권 기록을 불러옵니다.
    df = pd.read_csv(DATA_URL)
    # 여덟 자리 숫자로 된 날짜 열을 진짜 날짜(datetime)로 바꿉니다.
    df["날짜"] = pd.to_datetime(df["날짜"].astype(str), format="%Y%m%d")
    return df


df = load_data()

# ─────────────────────────────────────────────────────────────────
# 📊 그래프 1. 한 영화의 흥행 곡선
# ─────────────────────────────────────────────────────────────────
st.header("1. 한 영화의 흥행 곡선")

# 드롭다운으로 영화를 고릅니다.
movie_list = sorted(df["영화명"].unique())
selected_movie = st.selectbox("영화를 고르세요:", movie_list)

# 선택한 영화 데이터 추출 및 정렬
one_movie_df = df[df["영화명"] == selected_movie].sort_values("날짜")

# Plotly 라인 차트 생성
fig1 = px.line(
    one_movie_df,
    x="날짜",
    y="일관객",
    title=f"[{selected_movie}] 일별 관객수 변화 추이",
    labels={"날짜": "날짜", "일관객": "일일 관객수(명)"},
    markers=True,
)

# 마우스 오버(Hover) 툴팁 및 레이아웃 설정
fig1.update_traces(
    hovertemplate="<b>날짜:</b> %{x|%Y-%m-%d}<br><b>관객수:</b> %{y:,}명<extra></extra>"
)
fig1.update_layout(hovermode="x unified")

# Streamlit 그래프 출력 (화면 너비에 맞춤)
st.plotly_chart(fig1, use_container_width=True)

# 인사이트 기록란
st.info("💡 **이 그래프로 알 수 있는 것:** (한 문장으로 적어 보세요)")

st.markdown("---")

